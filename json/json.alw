# ============================================================
# json.alw - Minimal JSON field extractor for AlwexScript
# ============================================================
# Все аргументы автоматически преобразуются к строке,
# поэтому библиотека не упадёт, если передать число.
# ============================================================

func json_get_string
    let src = "" + arg0
    let key = "" + arg1

    let p1 = '"' + key
    let pattern = p1 + '":'
    let src_len = len(src)
    let pat_len = len(pattern)
    let i = 0
    let found = -1

    while i < src_len
        let stop = i + pat_len
        let window = slice(src, i, stop)
        if window == pattern
            let found = stop
            break
        end
        let i = i + 1
    endloop

    if found == -1
        let json_get_string_result = ''
    else
        let idx = found
        let n = len(src)

        while idx < n
            let stop = idx + 1
            let wch = slice(src, idx, stop)
            if wch == ' '
                let idx = stop
            else
                break
            end
        endloop

        let start = idx
        let stop = start + 1
        let first = slice(src, start, stop)

        if first == '"'
            let i2 = stop
            let result = ''

            while i2 < n
                let stop2 = i2 + 1
                let ch = slice(src, i2, stop2)

                if ch == '"'
                    break
                else
                    let result = result + ch
                    let i2 = stop2
                end
            endloop

            let json_get_string_result = result
        else
            let json_get_string_result = ''
        end
    end
end


func json_get_number
    let src = "" + arg0
    let key = "" + arg1

    let p1 = '"' + key
    let pattern = p1 + '":'
    let src_len = len(src)
    let pat_len = len(pattern)
    let i = 0
    let found = -1

    while i < src_len
        let stop = i + pat_len
        let window = slice(src, i, stop)
        if window == pattern
            let found = stop
            break
        end
        let i = i + 1
    endloop

    if found == -1
        let json_get_number_result = ''
    else
        let idx = found
        let n = len(src)

        while idx < n
            let stop = idx + 1
            let wch = slice(src, idx, stop)
            if wch == ' '
                let idx = stop
            else
                break
            end
        endloop

        let i2 = idx
        let result = ''

        while i2 < n
            let stop2 = i2 + 1
            let ch = slice(src, i2, stop2)
            if ch == ','
                break
            else if ch == '}'
                break
            else if ch == ']'
                break
            else
                let result = result + ch
                let i2 = stop2
            end
        endloop

        let json_get_number_result = result
    end
end


func json_get_bool
    let src = "" + arg0
    let key = "" + arg1

    let p1 = '"' + key
    let pattern = p1 + '":'
    let src_len = len(src)
    let pat_len = len(pattern)
    let i = 0
    let found = -1

    while i < src_len
        let stop = i + pat_len
        let window = slice(src, i, stop)
        if window == pattern
            let found = stop
            break
        end
        let i = i + 1
    endloop

    if found == -1
        let json_get_bool_result = ''
    else
        let idx = found
        let n = len(src)

        while idx < n
            let stop = idx + 1
            let wch = slice(src, idx, stop)
            if wch == ' '
                let idx = stop
            else
                break
            end
        endloop

        let start = idx
        let stop4 = start + 4
        let word4 = slice(src, start, stop4)

        if word4 == 'true'
            let json_get_bool_result = 'true'
        else
            let stop5 = start + 5
            let word5 = slice(src, start, stop5)
            if word5 == 'false'
                let json_get_bool_result = 'false'
            else
                let json_get_bool_result = ''
            end
        end
    end
end


func json_get_object
    let src = "" + arg0
    let key = "" + arg1

    let p1 = '"' + key + '"'
    let src_len = len(src)
    let key_len = len(p1)
    let i = 0
    let found = -1

    while i < src_len
        let stop = i + key_len
        let window = slice(src, i, stop)
        if window == p1
            let j = stop
            let n = len(src)
            while j < n
                let ch_end = j + 1
                let ch = slice(src, j, ch_end)
                if ch == ' '
                    let j = ch_end
                else if ch == '\t'
                    let j = ch_end
                else if ch == '\n'
                    let j = ch_end
                else if ch == '\r'
                    let j = ch_end
                else if ch == ':'
                    let found = ch_end
                    break
                else
                    break
                end
            endloop
        end
        if found != -1
            break
        end
        let i = i + 1
    endloop

    if found == -1
        let json_get_object_result = ''
    else
        let idx = found
        let n = len(src)

        while idx < n
            let ch_end = idx + 1
            let ch = slice(src, idx, ch_end)
            if ch == ' '
                let idx = ch_end
            else if ch == '\t'
                let idx = ch_end
            else if ch == '\n'
                let idx = ch_end
            else
                break
            end
        endloop

        let obj_start = idx
        let fp_end = obj_start + 1
        let first = slice(src, obj_start, fp_end)

        if first == '{'
            let depth = 0
            let i2 = obj_start
            while i2 < n
                let ch_end = i2 + 1
                let ch = slice(src, i2, ch_end)
                if ch == '{'
                    let depth = depth + 1
                else if ch == '}'
                    let depth = depth - 1
                end
                let i2 = ch_end
                if depth == 0
                    break
                end
            endloop
            let json_get_object_result = slice(src, obj_start, i2)
        else
            let json_get_object_result = ''
        end
    end
end


func json_get_array
    let src = "" + arg0
    let key = "" + arg1

    let p1 = '"' + key
    let pattern = p1 + '":'
    let src_len = len(src)
    let pat_len = len(pattern)
    let i = 0
    let found = -1

    while i < src_len
        let stop = i + pat_len
        let window = slice(src, i, stop)
        if window == pattern
            let found = stop
            break
        end
        let i = i + 1
    endloop

    if found == -1
        let json_get_array_result = ''
    else
        let idx = found
        let n = len(src)

        while idx < n
            let stop = idx + 1
            let wch = slice(src, idx, stop)
            if wch == ' '
                let idx = stop
            else
                break
            end
        endloop

        let arr_start = idx
        let fp_end = arr_start + 1
        let first = slice(src, arr_start, fp_end)

        if first == '['
            let depth = 0
            let i2 = arr_start
            while i2 < n
                let ch_end = i2 + 1
                let ch = slice(src, i2, ch_end)
                if ch == '['
                    let depth = depth + 1
                else if ch == ']'
                    let depth = depth - 1
                end
                let i2 = ch_end
                if depth == 0
                    break
                end
            endloop
            let json_get_array_result = slice(src, arr_start, i2)
        else
            let json_get_array_result = ''
        end
    end
end


func json_split_array
    let arr_str = "" + arg0
    let n = len(arr_str)
    let last = n - 1

    let items = []
    let depth = 0
    let in_string = 0
    let current = ''
    let i = 1

    while i < last
        let stop = i + 1
        let ch = slice(arr_str, i, stop)

        if in_string == 1
            let current = current + ch
            if ch == '"'
                let in_string = 0
            end
        else
            if ch == '"'
                let in_string = 1
                let current = current + ch
            else if ch == '['
                let depth = depth + 1
                let current = current + ch
            else if ch == '{'
                let depth = depth + 1
                let current = current + ch
            else if ch == ']'
                let depth = depth - 1
                let current = current + ch
            else if ch == '}'
                let depth = depth - 1
                let current = current + ch
            else if ch == ','
                if depth == 0
                    arr_push items current
                    let current = ''
                else
                    let current = current + ch
                end
            else
                let current = current + ch
            end
        end

        let i = stop
    endloop

    let cur_len = len(current)
    if cur_len > 0
        arr_push items current
    end

    let json_split_array_result = items
end
